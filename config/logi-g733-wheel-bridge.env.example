# Optional runtime settings for the G733 wheel bridge service.
# Copy these into ~/.config/logi-g733-wheel-bridge.env or let install.sh do it.

# Volume step per wheel notch.
G733_WHEEL_STEP=0.02

# Optional burst normalization. Increase this if one wheel notch feels like
# multiple volume jumps on your system. Set to 0 to process every event.
G733_WHEEL_MIN_INTERVAL_MS=40

# One of: auto, wpctl, pactl
# G733_WHEEL_BACKEND=auto

# Override the target sink name or ID.
# PipeWire default: @DEFAULT_AUDIO_SINK@
# PulseAudio default: @DEFAULT_SINK@
# G733_WHEEL_SINK=

# Override the target source name or ID for one-shot mic mute commands.
# PipeWire default: @DEFAULT_AUDIO_SOURCE@
# PulseAudio default: @DEFAULT_SOURCE@
# G733_WHEEL_SOURCE=

# Set to true only if you want the headset mute key to toggle desktop output mute.
# By default the daemon leaves the headset mute button alone.
# G733_WHEEL_HANDLE_MUTE=false

# Override the auto-detected input event path.
# G733_WHEEL_EVENT=/dev/input/event17

# Override the auto-detected device name if Logitech changes it in a future firmware.
# G733_WHEEL_DEVICE_NAME=Logitech G733 Gaming Headset Consumer Control

# Set to true if you want exclusive access to the input device.
# G733_WHEEL_GRAB=false
